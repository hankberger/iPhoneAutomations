{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "advanced-automations",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // nodejs_compat also exposes [vars] on process.env, which src/inference.js reads MARKUP from.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "advanced-automations",
      "database_id": "fafe6876-77c8-4787-b299-93d2c8d0eb45",
      "migrations_dir": "migrations"
    },
    // Hank's shared Waitlist database. Its schema is owned elsewhere: no migrations from this repo.
    { "binding": "WAITLIST_DB", "database_name": "waitlist", "database_id": "e5cab21f-42c9-43aa-a581-87191c0b01c2" }
  ],
  "vars": {
    "MARKUP": "1.5"
    // APP_URL defaults to the request origin; set it once a custom domain is attached.
  },
  "observability": { "enabled": true },
  // "ai" is deliberately left off env.local; Wrangler warns about it and that is expected.
  "env": {
    // `npm run dev:local`: fully local D1, and Workers AI over the REST API with
    // CLOUDFLARE_API_TOKEN from .dev.vars instead of the binding's remote proxy.
    "local": {
      "d1_databases": [
        { "binding": "DB", "database_name": "advanced-automations", "database_id": "local", "migrations_dir": "migrations" },
        // Create its table locally with scripts/waitlist-local.sql (see README).
        { "binding": "WAITLIST_DB", "database_name": "waitlist", "database_id": "local-waitlist" }
      ],
      "vars": { "MARKUP": "1.5", "CLOUDFLARE_ACCOUNT_ID": "266374eb0451487fc2fc18565ade47cc" }
    }
  }
  // Secrets (never in this file): wrangler secret put STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
}
