#define color green
#define glyph basket
#define from sharesheet
#define inputs text, richtext, webpage, url
#define noinput getclipboard

action 'addnewreminder' addReminder(text title: 'WFCalendarItemTitle')

const input = getText(ShortcutInput)
// @call
const items = splitText("{result}", "\n")
for item in items {
    addReminder("{@item}")
}
const added = count(items)
showNotification("{result}", "Added {added} items to Reminders")
