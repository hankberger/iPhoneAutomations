#define color blue
#define glyph tag

// Called from another shortcut with one item, or with a List: what to work on first,
// your instructions last. Anything missing is asked for.
@content = ShortcutInput
@instructions = ""
const items = count(ShortcutInput)
if items > 1 {
    @content = getFirstItem(ShortcutInput)
    const last = getLastItem(ShortcutInput)
    @instructions = getText(last)
}
if !ShortcutInput {
    @content = prompt("What should I sort? For example, paste an email or a note.")
}
if !@instructions {
    @instructions = prompt("Which categories? For example: Work, Personal, Errands")
}
const input = getText(@content)
// @call
if !ShortcutInput {
    quicklook(result)
}
output("{result}")
