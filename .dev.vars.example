# Local secrets for `npm run dev` (wrangler dev). Copy to .dev.vars; never commit it.
# Test key from dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8787/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# Only for `npm run dev:local`: a token with Workers AI Read, used instead of the AI binding.
CLOUDFLARE_API_TOKEN=
# Optional: Sign in with Google (console.cloud.google.com > APIs & Services > Credentials, Web client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Sign in with Apple (developer.apple.com: Services ID, Team ID, and a Sign in with Apple key).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 file; \n escapes are fine on one line.
APPLE_PRIVATE_KEY=
# 32 random bytes encoded as 64 hex characters; keep separately from database backups.
# Required when Sign in with Apple is enabled; never commit the real value.
TOKEN_ENCRYPTION_KEY=
# App Store server API key (not the Sign in with Apple key).
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
APP_STORE_APP_ID=
# Dedicated review/test accounts only. Sandbox purchases never fund arbitrary accounts.
APP_STORE_SANDBOX_USER_IDS=
# Keep false until the deletion/late-payment release gates in docs/app-store-review.md pass.
ACCOUNT_DELETION_ENABLED=false
# Private analytics operators: verified Google/Apple emails, or approved existing IDs.
ADMIN_EMAILS=
ADMIN_USER_IDS=
