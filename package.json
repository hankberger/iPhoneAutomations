{
  "name": "advanced-automations",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler d1 migrations apply advanced-automations --local --env local && wrangler dev --env local",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply advanced-automations --local",
    "db:migrate:remote": "wrangler d1 migrations apply advanced-automations --remote",
    "mockups": "node --env-file-if-exists=.env scripts/generate-mockups.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "shortcuts": "node scripts/build-shortcuts.mjs",
    "ios:catalog": "node scripts/ios-catalog.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "hono": "^4.13.9",
    "stripe": "^22.6.2"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "wrangler": "^4.141.0"
  }
}
