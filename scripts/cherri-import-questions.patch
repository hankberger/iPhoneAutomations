 	// Determine identifier
 	var ident = getFullActionIdentifier()
 	// Determine parameters
+	// Point import questions at this action's final position. The parser's action count
+	// misses the extra actions emitted for variables and control flow, so it is only known here.
+	for i, argument := range arguments {
+		if argument.valueType != Question {
+			continue
+		}
+		if q, found := questions[fmt.Sprint(argument.value)]; found {
+			q.actionIndex = len(shortcut.WFWorkflowActions)
+			arguments[i].value = ""
+		}
+	}
 	var params = getActionParameters(arguments)
 	// Additionally add the output name and UUID of this action if provided
 	addAction(ident, attachReferenceToParams(params, reference))
