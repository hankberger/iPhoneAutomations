+
+// integralNumbers turns whole float64s back into ints, so plist writes <integer> where
+// Shortcuts expects one (JSON-style dictionary literals parse every number as a float).
+func integralNumbers(value any) any {
+	switch v := value.(type) {
+	case float64:
+		if v == float64(int64(v)) {
+			return int64(v)
+		}
+	case map[string]any:
+		for key, item := range v {
+			v[key] = integralNumbers(item)
+		}
+	case []any:
+		for i, item := range v {
+			v[i] = integralNumbers(item)
+		}
+	}
+	return value
+}
